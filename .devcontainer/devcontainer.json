{
  "name": "Aura",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=${localEnv:HOME}/dev/imp-ts,target=${containerWorkspaceFolder}/.mnt/imp-ts,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/dev/imp-spec,target=${containerWorkspaceFolder}/.mnt/imp-spec,type=bind,consistency=cached"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy"
      }
    }
  }
}
