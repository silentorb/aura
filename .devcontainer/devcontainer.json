{
  "name": "Aura",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "remoteUser": "vscode",
  "postCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y -qq libasound2-dev pkg-config && rustc --version && cargo --version",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy"
      }
    }
  }
}
